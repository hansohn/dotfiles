# Login shells.

# Homebrew: /opt/homebrew on Apple Silicon, /usr/local on Intel, and
# /home/linuxbrew on Linux if it happens to be installed. Guarded so a Linux
# box without brew does not error on every login.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$_brew" ]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
